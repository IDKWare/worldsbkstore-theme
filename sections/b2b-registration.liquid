{%- style -%}
  #shopify-section-{{ section.id }} {
    --b2b-text: {{ section.settings.text_color }};
    --b2b-card: {{ section.settings.card_background }};
    --b2b-overlay: {{ section.settings.overlay_color }};
    --b2b-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .b2b-register-{{ section.id }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: {{ section.settings.min_height }}px;
    background: #111;
  }

  .b2b-register-{{ section.id }} .b2b-register__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .b2b-register-{{ section.id }} .b2b-register__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.background_position }};
    display: block;
  }

  .b2b-register-{{ section.id }} .b2b-register__media--fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 18%, rgba(255,255,255,.10), transparent 34%),
      linear-gradient(135deg, #111 0%, #242424 100%);
  }

  .b2b-register-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--b2b-overlay);
    opacity: var(--b2b-overlay-opacity);
  }

  .b2b-register-{{ section.id }} .b2b-register__inner {
    width: min(1440px, calc(100% - 64px));
    margin: 0 auto;
    padding: 72px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(460px, 620px);
    gap: clamp(48px, 7vw, 110px);
    align-items: center;
  }

  .b2b-register-{{ section.id }} .b2b-register__content {
    color: var(--b2b-text);
    max-width: 620px;
    padding: 24px 0;
  }

  .b2b-register-{{ section.id }} .b2b-register__partner {
    margin: 0 0 40px;
  }

  .b2b-register-{{ section.id }} .b2b-register__partner img {
    width: auto;
    height: auto;
    max-width: {{ section.settings.logo_width }}px;
    max-height: 110px;
    display: block;
  }

  .b2b-register-{{ section.id }} .b2b-register__eyebrow {
    margin: 0 0 16px;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    opacity: .78;
  }

  .b2b-register-{{ section.id }} .b2b-register__title {
    margin: 0;
    max-width: 760px;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: clamp(40px, 5vw, 72px);
    line-height: .98;
    letter-spacing: -.025em;
    color: inherit;
  }

  .b2b-register-{{ section.id }} .b2b-register__text {
    margin-top: 28px;
    max-width: 570px;
    font-size: 17px;
    line-height: 1.65;
    color: inherit;
    opacity: .9;
  }

  .b2b-register-{{ section.id }} .b2b-register__text p {
    margin: 0 0 12px;
  }

  .b2b-register-{{ section.id }} .b2b-register__steps {
    margin: 38px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    list-style: none;
  }

  .b2b-register-{{ section.id }} .b2b-register__step {
    border-top: 1px solid rgba(255,255,255,.42);
    padding-top: 14px;
  }

  .b2b-register-{{ section.id }} .b2b-register__step-number {
    display: block;
    margin-bottom: 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    opacity: .66;
  }

  .b2b-register-{{ section.id }} .b2b-register__step-text {
    display: block;
    font-size: 14px;
    line-height: 1.4;
  }

  .b2b-register-{{ section.id }} .b2b-register__card {
    background: var(--b2b-card);
    border-radius: 10px;
    padding: clamp(26px, 3.2vw, 46px);
    box-shadow: 0 28px 70px rgba(0,0,0,.22);
  }

  .b2b-register-{{ section.id }} .b2b-register__card-title {
    margin: 0 0 8px;
    color: #202020;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: clamp(26px, 2.3vw, 34px);
    line-height: 1.15;
  }

  .b2b-register-{{ section.id }} .b2b-register__card-text {
    margin: 0 0 24px;
    color: rgba(32,32,32,.7);
    font-size: 14px;
    line-height: 1.55;
  }

  .b2b-register-{{ section.id }} .b2b-register__form > * {
    margin: 0 !important;
  }

  @media screen and (max-width: 989px) {
    .b2b-register-{{ section.id }} {
      min-height: auto;
    }

    .b2b-register-{{ section.id }} .b2b-register__inner {
      width: min(100% - 40px, 760px);
      padding: 54px 0;
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .b2b-register-{{ section.id }} .b2b-register__content {
      padding: 0;
    }

    .b2b-register-{{ section.id }} .b2b-register__partner {
      margin-bottom: 30px;
    }
  }

  @media screen and (max-width: 749px) {
    .b2b-register-{{ section.id }} .b2b-register__inner {
      width: calc(100% - 28px);
      padding: 36px 0;
      gap: 30px;
    }

    .b2b-register-{{ section.id }} .b2b-register__title {
      font-size: clamp(36px, 11vw, 52px);
    }

    .b2b-register-{{ section.id }} .b2b-register__text {
      margin-top: 20px;
      font-size: 15px;
    }

    .b2b-register-{{ section.id }} .b2b-register__steps {
      margin-top: 28px;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .b2b-register-{{ section.id }} .b2b-register__step {
      display: grid;
      grid-template-columns: 36px 1fr;
      align-items: start;
      gap: 8px;
      padding-top: 10px;
    }

    .b2b-register-{{ section.id }} .b2b-register__step-number {
      margin: 0;
    }

    .b2b-register-{{ section.id }} .b2b-register__card {
      border-radius: 8px;
      padding: 24px 18px;
    }
  }
{%- endstyle -%}

<section class="b2b-register-{{ section.id }}">
  <div class="b2b-register__media" aria-hidden="true">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 2600
        | image_tag:
          widths: '900, 1200, 1600, 2000, 2600',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {%- else -%}
      <div class="b2b-register__media--fallback"></div>
    {%- endif -%}
  </div>

  <div class="b2b-register__inner">
    <div class="b2b-register__content">
      {%- if section.settings.partner_logo != blank -%}
        <div class="b2b-register__partner">
          {{
            section.settings.partner_logo
            | image_url: width: 1000
            | image_tag:
              widths: '240, 400, 600, 800, 1000',
              sizes: '(max-width: 749px) 180px, 260px',
              loading: 'eager'
          }}
        </div>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="b2b-register__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="b2b-register__title">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="b2b-register__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      <ol class="b2b-register__steps" aria-label="Registration process">
        <li class="b2b-register__step">
          <span class="b2b-register__step-number">01</span>
          <span class="b2b-register__step-text">{{ section.settings.step_1 | escape }}</span>
        </li>
        <li class="b2b-register__step">
          <span class="b2b-register__step-number">02</span>
          <span class="b2b-register__step-text">{{ section.settings.step_2 | escape }}</span>
        </li>
        <li class="b2b-register__step">
          <span class="b2b-register__step-number">03</span>
          <span class="b2b-register__step-text">{{ section.settings.step_3 | escape }}</span>
        </li>
      </ol>
    </div>

    <div class="b2b-register__card">
      {%- if section.settings.form_heading != blank -%}
        <h2 class="b2b-register__card-title">{{ section.settings.form_heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.form_text != blank -%}
        <p class="b2b-register__card-text">{{ section.settings.form_text | escape }}</p>
      {%- endif -%}

      <div class="b2b-register__form">
        {%- for block in section.blocks -%}
          {% render block %}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "B2B registration",
  "tag": "section",
  "class": "section-b2b-registration",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background position",
      "default": "center center",
      "options": [
        { "value": "left center", "label": "Left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Right" }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 55
    },
    {
      "type": "image_picker",
      "id": "partner_logo",
      "label": "Penguin Vila logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 120,
      "max": 420,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 240
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "B2B REGISTRATION"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Professional access to WorldSBK Store"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Register your company to request access to our professional catalogue and B2B commercial conditions.</p>"
    },
    {
      "type": "text",
      "id": "step_1",
      "label": "Step 1",
      "default": "Complete the registration form"
    },
    {
      "type": "text",
      "id": "step_2",
      "label": "Step 2",
      "default": "We review your company details"
    },
    {
      "type": "text",
      "id": "step_3",
      "label": "Step 3",
      "default": "Your B2B access is activated"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Business registration"
    },
    {
      "type": "text",
      "id": "form_text",
      "label": "Form text",
      "default": "Complete your company details below. Applications are reviewed before B2B access is enabled."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Form card background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 640,
      "max": 1100,
      "step": 20,
      "unit": "px",
      "label": "Minimum section height",
      "default": 800
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "B2B registration"
    }
  ]
}
{% endschema %}