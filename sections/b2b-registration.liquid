{%- style -%}
  #shopify-section-{{ section.id }} {
    --b2b-text: {{ section.settings.text_color }};
    --b2b-card: {{ section.settings.card_background }};
    --b2b-bg: {{ section.settings.background_color }};
    --b2b-border: rgba(17,17,17,.10);
  }

  .b2b-register-{{ section.id }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: {{ section.settings.min_height }}px;
    background: var(--b2b-bg);
  }

  .b2b-register-{{ section.id }} .b2b-register__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .b2b-register-{{ section.id }} .b2b-register__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.background_position }};
    display: block;
    opacity: .11;
    filter: grayscale(1);
  }

  .b2b-register-{{ section.id }} .b2b-register__media--fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 15% 20%, rgba(0,0,0,.035), transparent 26%),
      radial-gradient(circle at 82% 75%, rgba(0,0,0,.028), transparent 24%),
      var(--b2b-bg);
  }

  .b2b-register-{{ section.id }}::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(255,255,255,.24), rgba(255,255,255,0));
  }

  .b2b-register-{{ section.id }} .b2b-register__inner {
    width: min(1380px, calc(100% - 72px));
    margin: 0 auto;
    padding: 50px 0 56px;
    display: grid;
    grid-template-columns: minmax(320px, .82fr) minmax(560px, 1.18fr);
    gap: clamp(54px, 6vw, 96px);
    align-items: center;
  }

  .b2b-register-{{ section.id }} .b2b-register__content {
    color: var(--b2b-text);
    max-width: 560px;
  }

  .b2b-register-{{ section.id }} .b2b-register__partner {
    margin: 0 0 30px;
    display: flex;
    align-items: flex-start;
  }

  .b2b-register-{{ section.id }} .b2b-register__partner img {
    width: auto;
    height: auto;
    max-width: {{ section.settings.logo_width }}px;
    max-height: 105px;
    display: block;
    object-fit: contain;
    object-position: left top;
  }

  .b2b-register-{{ section.id }} .b2b-register__eyebrow {
    margin: 0 0 12px;
    font-size: 10px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    opacity: .58;
  }

  .b2b-register-{{ section.id }} .b2b-register__title {
    margin: 0;
    max-width: 540px;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: clamp(34px, 3.2vw, 46px);
    line-height: 1.06;
    letter-spacing: -.022em;
    color: inherit;
  }

  .b2b-register-{{ section.id }} .b2b-register__text {
    margin-top: 20px;
    max-width: 500px;
    font-size: 15px;
    line-height: 1.62;
    color: inherit;
    opacity: .72;
  }

  .b2b-register-{{ section.id }} .b2b-register__text p {
    margin: 0 0 10px;
  }

  .b2b-register-{{ section.id }} .b2b-register__steps {
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    list-style: none;
  }

  .b2b-register-{{ section.id }} .b2b-register__step {
    border-top: 1px solid rgba(17,17,17,.18);
    padding-top: 11px;
  }

  .b2b-register-{{ section.id }} .b2b-register__step-number {
    display: block;
    margin-bottom: 5px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    opacity: .46;
  }

  .b2b-register-{{ section.id }} .b2b-register__step-text {
    display: block;
    font-size: 12px;
    line-height: 1.42;
  }

  .b2b-register-{{ section.id }} .b2b-register__card {
    background: var(--b2b-card);
    border: 1px solid var(--b2b-border);
    border-radius: 6px;
    padding: clamp(28px, 2.5vw, 38px);
    box-shadow: 0 12px 34px rgba(0,0,0,.06);
  }

  .b2b-register-{{ section.id }} .b2b-register__card-title {
    margin: 0 0 7px;
    color: #171717;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: clamp(24px, 1.9vw, 30px);
    line-height: 1.15;
  }

  .b2b-register-{{ section.id }} .b2b-register__card-text {
    margin: 0 0 18px;
    color: rgba(23,23,23,.58);
    font-size: 12px;
    line-height: 1.55;
    max-width: 560px;
  }

  .b2b-register-{{ section.id }} .b2b-register__form > * {
    margin: 0 !important;
  }

  @media screen and (max-width: 989px) {
    .b2b-register-{{ section.id }} {
      min-height: auto;
    }

    .b2b-register-{{ section.id }} .b2b-register__inner {
      width: min(100% - 40px, 800px);
      padding: 42px 0 48px;
      grid-template-columns: 1fr;
      gap: 34px;
      align-items: start;
    }

    .b2b-register-{{ section.id }} .b2b-register__content {
      max-width: 640px;
    }
  }

  @media screen and (max-width: 749px) {
    .b2b-register-{{ section.id }} .b2b-register__inner {
      width: calc(100% - 28px);
      padding: 30px 0 34px;
      gap: 26px;
    }

    .b2b-register-{{ section.id }} .b2b-register__partner {
      margin-bottom: 22px;
    }

    .b2b-register-{{ section.id }} .b2b-register__partner img {
      max-width: min({{ section.settings.logo_width }}px, 170px);
      max-height: 88px;
    }

    .b2b-register-{{ section.id }} .b2b-register__title {
      font-size: clamp(31px, 9vw, 40px);
    }

    .b2b-register-{{ section.id }} .b2b-register__text {
      margin-top: 16px;
      font-size: 14px;
    }

    .b2b-register-{{ section.id }} .b2b-register__steps {
      margin-top: 22px;
      grid-template-columns: 1fr;
      gap: 9px;
    }

    .b2b-register-{{ section.id }} .b2b-register__step {
      display: grid;
      grid-template-columns: 30px 1fr;
      align-items: start;
      gap: 7px;
      padding-top: 8px;
    }

    .b2b-register-{{ section.id }} .b2b-register__step-number {
      margin: 0;
    }

    .b2b-register-{{ section.id }} .b2b-register__card {
      border-radius: 5px;
      padding: 22px 16px;
    }
  }
{%- endstyle -%}

<section class="b2b-register-{{ section.id }}">
  <div class="b2b-register__media" aria-hidden="true">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 2600
        | image_tag:
          widths: '900, 1200, 1600, 2000, 2600',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {%- else -%}
      <div class="b2b-register__media--fallback"></div>
    {%- endif -%}
  </div>

  <div class="b2b-register__inner">
    <div class="b2b-register__content">
      {%- if section.settings.partner_logo != blank -%}
        <div class="b2b-register__partner">
          {{
            section.settings.partner_logo
            | image_url: width: 1000
            | image_tag:
              widths: '240, 400, 600, 800, 1000',
              sizes: '(max-width: 749px) 170px, 220px',
              loading: 'eager'
          }}
        </div>
      {%- elsif section.settings.partner_logo_url != blank -%}
        <div class="b2b-register__partner">
          <img
            src="{{ section.settings.partner_logo_url | escape }}"
            alt="Penguin Vila"
            loading="eager"
            width="{{ section.settings.logo_width }}"
            height="auto"
          >
        </div>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="b2b-register__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="b2b-register__title">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="b2b-register__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      <ol class="b2b-register__steps" aria-label="Registration process">
        <li class="b2b-register__step">
          <span class="b2b-register__step-number">01</span>
          <span class="b2b-register__step-text">{{ section.settings.step_1 | escape }}</span>
        </li>
        <li class="b2b-register__step">
          <span class="b2b-register__step-number">02</span>
          <span class="b2b-register__step-text">{{ section.settings.step_2 | escape }}</span>
        </li>
        <li class="b2b-register__step">
          <span class="b2b-register__step-number">03</span>
          <span class="b2b-register__step-text">{{ section.settings.step_3 | escape }}</span>
        </li>
      </ol>
    </div>

    <div class="b2b-register__card">
      {%- if section.settings.form_heading != blank -%}
        <h2 class="b2b-register__card-title">{{ section.settings.form_heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.form_text != blank -%}
        <p class="b2b-register__card-text">{{ section.settings.form_text | escape }}</p>
      {%- endif -%}

      <div class="b2b-register__form">
        {%- for block in section.blocks -%}
          {% render block %}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.two_column_form -%}
<script>
  (function () {
    const sectionId = {{ section.id | json }};
    const sectionEl = document.getElementById('shopify-section-' + sectionId);
    if (!sectionEl) return;

    function singleControlWrapper(input, root) {
      let node = input;

      while (node && node.parentElement && node.parentElement !== root) {
        const parent = node.parentElement;
        const controls = parent.querySelectorAll(
          'input:not([type="hidden"]), select, textarea:not([name^="h-captcha"])'
        );

        if (controls.length !== 1) break;
        node = parent;
      }

      return node;
    }

    function pairFields(root, firstId, secondId) {
      const first = root.querySelector('#' + firstId);
      const second = root.querySelector('#' + secondId);
      if (!first || !second) return;

      const firstWrap = singleControlWrapper(first, root);
      const secondWrap = singleControlWrapper(second, root);
      if (!firstWrap || !secondWrap) return;
      if (!firstWrap.parentElement || firstWrap.parentElement !== secondWrap.parentElement) return;

      const parent = firstWrap.parentElement;
      parent.classList.add('wm-b2b-grid');

      Array.from(parent.children).forEach(function (child) {
        child.classList.add('wm-b2b-grid-full');
      });

      firstWrap.classList.remove('wm-b2b-grid-full');
      secondWrap.classList.remove('wm-b2b-grid-full');
      firstWrap.classList.add('wm-b2b-grid-half');
      secondWrap.classList.add('wm-b2b-grid-half');
    }

    function applyFormLayout() {
      const embed = sectionEl.querySelector('shopify-forms-embed#app-embed') ||
                    sectionEl.querySelector('shopify-forms-embed');

      if (!embed || !embed.shadowRoot) return false;
      const root = embed.shadowRoot;

      if (!root.querySelector('#wm-b2b-two-column-style')) {
        const style = document.createElement('style');
        style.id = 'wm-b2b-two-column-style';
        style.textContent = `
          .wm-b2b-grid {
            display: grid !important;
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            column-gap: 10px !important;
            row-gap: 0 !important;
          }
          .wm-b2b-grid > .wm-b2b-grid-full {
            grid-column: 1 / -1 !important;
          }
          .wm-b2b-grid > .wm-b2b-grid-half {
            grid-column: auto !important;
            min-width: 0 !important;
          }
          @media (max-width: 640px) {
            .wm-b2b-grid {
              grid-template-columns: 1fr !important;
            }
            .wm-b2b-grid > .wm-b2b-grid-half,
            .wm-b2b-grid > .wm-b2b-grid-full {
              grid-column: 1 / -1 !important;
            }
          }
        `;
        root.appendChild(style);
      }

      pairFields(root, 'first_name', 'last_name');
      pairFields(root, 'email', 'company_tax_id');

      return true;
    }

    let tries = 0;
    const timer = setInterval(function () {
      tries += 1;
      const ready = applyFormLayout();
      if (ready || tries > 40) clearInterval(timer);
    }, 250);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "B2B registration",
  "tag": "section",
  "class": "section-b2b-registration",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F4F4F1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Optional background image"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background position",
      "default": "center center",
      "options": [
        { "value": "left center", "label": "Left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Right" }
      ]
    },
    {
      "type": "image_picker",
      "id": "partner_logo",
      "label": "Penguin Vila logo"
    },
    {
      "type": "text",
      "id": "partner_logo_url",
      "label": "Penguin Vila logo URL",
      "default": "https://cdn.shopify.com/s/files/1/0602/5569/9104/files/versio-vert.png?v=1789398376"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 120,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 180
    },
    {
      "type": "checkbox",
      "id": "two_column_form",
      "label": "Use two columns in form",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "B2B REGISTRATION"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Professional access to WorldSBK Store"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Register your company to request access to our professional catalogue and B2B commercial conditions.</p>"
    },
    {
      "type": "text",
      "id": "step_1",
      "label": "Step 1",
      "default": "Complete the registration form"
    },
    {
      "type": "text",
      "id": "step_2",
      "label": "Step 2",
      "default": "We review your company details"
    },
    {
      "type": "text",
      "id": "step_3",
      "label": "Step 3",
      "default": "Your B2B access is activated"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Business registration"
    },
    {
      "type": "text",
      "id": "form_text",
      "label": "Form text",
      "default": "Complete your company details below. Applications are reviewed before B2B access is enabled."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Form card background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 600,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Minimum section height",
      "default": 680
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "B2B registration"
    }
  ]
}
{% endschema %}